{
  "name": "agent-query-crawl",
  "version": "0.0.0",
  "description": "Agent-oriented internet query, Exa search, and safe page crawling utilities.",
  "author": "respectmathias",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RespectMathias/agent-query-crawl.git"
  },
  "bugs": {
    "url": "https://github.com/RespectMathias/agent-query-crawl/issues"
  },
  "homepage": "https://github.com/RespectMathias/agent-query-crawl#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js",
      "default": "./dist/proxy.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "provenance": false
  },
  "keywords": [
    "agent",
    "query",
    "crawl",
    "crawler",
    "exa",
    "web-search",
    "web-fetch"
  ]
}